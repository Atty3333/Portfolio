<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-width=1.0">
    <title>Portfolio | Software & Beats</title>
    <style>
        /* CSS Architecture */
        :root {
            --bg-color: #0f0f13;
            --surface-color: #1c1c21;
            --primary-accent: #6c5ce7;
            --text-main: #f5f6fa;
            --text-muted: #a4b0be;
            --font-family: 'Segoe UI', system-ui, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: var(--font-family);
            line-height: 1.6;
        }

        /* Navigation */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem 5%;
            background-color: rgba(15, 15, 19, 0.9);
            backdrop-filter: blur(10px);
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid #333;
        }

        .nav-links {
            display: flex;
            gap: 1.5rem;
        }

        .nav-links button {
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 1rem;
            font-weight: 600;
            transition: color 0.2s;
        }

        .nav-links button:hover, .nav-links button.active {
            color: var(--primary-accent);
        }

        /* Container & Layout */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem 5%;
        }

        .section {
            display: none;
            animation: fadeIn 0.4s ease;
        }

        .section.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Hero Section */
        #hero {
            text-align: center;
            padding: 4rem 0;
            display: block; /* Always visible at start */
        }

        h1 {
            font-size: 3rem;
            margin-bottom: 0.5rem;
        }

        h2 {
            font-size: 1.5rem;
            color: var(--text-muted);
            margin-bottom: 2rem;
            font-weight: 400;
        }

        .social-links a {
            color: var(--text-main);
            text-decoration: none;
            margin: 0 10px;
            padding: 8px 16px;
            border-radius: 4px;
            background-color: var(--surface-color);
            transition: background 0.2s;
        }

        .social-links a:hover {
            background-color: var(--primary-accent);
        }

        /* Grid Layouts for Content */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .card {
            background-color: var(--surface-color);
            border-radius: 8px;
            padding: 1.5rem;
            border: 1px solid #333;
        }

        .card h3 {
            margin-bottom: 1rem;
            color: var(--primary-accent);
        }

        /* Responsive Media Embeds */
        .fluid-embed {
            aspect-ratio: 16 / 9;
            width: 100%;
            background-color: #000;
            border-radius: 4px;
            overflow: hidden;
            margin-bottom: 1rem;
        }

        .fluid-embed iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        /* Specific override for BeatStars player height */
        .beatstars-embed {
            width: 100%;
            height: 400px; 
            border: none;
            border-radius: 8px;
        }
    </style>
</head>
<body>

    <nav>
        <div class="logo"><strong>Portfolio</strong></div>
        <div class="nav-links" id="nav-container">
            <button class="active" onclick="showSection('overview', this)">Overview</button>
            <button onclick="showSection('software', this)">Software</button>
            <button onclick="showSection('music', this)">Beats</button>
            <button onclick="showSection('edits', this)">Edits</button>
            <button onclick="showSection('education', this)">Education</button>
        </div>
    </nav>

    <div class="container">
        
        <!-- Hero / Overview -->
        <div id="overview" class="section active">
            <div id="hero">
                <h1>Full-Stack Dev & Music Producer</h1>
                <h2>Crafting code and composing tracks.</h2>
                <div class="social-links">
                    <a href="https://github.com/YOUR_GITHUB" target="_blank">GitHub</a>
                    <a href="https://youtube.com/YOUR_CHANNEL" target="_blank">YouTube</a>
                    <a href="https://instagram.com/YOUR_INSTA" target="_blank">Instagram</a>
                    <a href="https://tiktok.com/@YOUR_TIKTOK" target="_blank">TikTok</a>
                </div>
            </div>
        </div>

        <!-- Software Engineering Section -->
        <div id="software" class="section">
            <h2>Software Engineering</h2>
            <div class="grid">
                <div class="card">
                    <h3>Kotlin Goals MVP</h3>
                    <p>Android application built in Kotlin. Architected with scalable UI components targeting deployment on the Google Play Store.</p>
                </div>
                <div class="card">
                    <h3>Python AI Agent</h3>
                    <p>Custom AI agent utilizing Llama models, Model Context Protocol (MCP) tools, and Groq APIs. Hosted on Hugging Face Spaces.</p>
                </div>
                <div class="card">
                    <h3>Ubuntu Home Server</h3>
                    <p>Self-hosted server infrastructure running Nextcloud for remote file synchronization, Moonlight, and Sunshine streaming protocols.</p>
                </div>
            </div>
        </div>

        <!-- Music / Beats Section -->
        <div id="music" class="section">
            <h2>Beat Production</h2>
            <p style="color: var(--text-muted); margin-bottom: 2rem;">Arranged, mixed, and mastered. Monitored via DXN PRO Y71s.</p>
            
            <!-- BeatStars Embed -->
            <iframe class="beatstars-embed" src="YOUR_BEATSTARS_BLAZE_PLAYER_URL_HERE"></iframe>
            
            <div class="grid" style="margin-top: 2rem;">
                <div class="card">
                    <h3>Latest YouTube Drop</h3>
                    <div class="fluid-embed">
                        <!-- Replace YOUR_VIDEO_ID with actual YouTube video ID -->
                        <iframe src="https://www.youtube.com/embed/YOUR_VIDEO_ID" allowfullscreen></iframe>
                    </div>
                </div>
                <div class="card">
                    <h3>Spotify Placements</h3>
                    <div class="fluid-embed" style="aspect-ratio: auto; height: 152px;">
                        <!-- Spotify Embed -->
                        <iframe src="https://open.spotify.com/embed/track/YOUR_TRACK_ID" width="100%" height="152" allow="encrypted-media"></iframe>
                    </div>
                </div>
            </div>
        </div>

        <!-- Video Edits Section -->
        <div id="edits" class="section">
            <h2>Video Edits</h2>
            <p style="color: var(--text-muted); margin-bottom: 2rem;">Cut and color graded using DaVinci Resolve.</p>
            <div class="grid">
                <div class="card">
                    <div class="fluid-embed">
                        <iframe src="https://www.youtube.com/embed/YOUR_VIDEO_ID" allowfullscreen></iframe>
                    </div>
                    <p>Visualizer edit utilizing advanced compound clip management.</p>
                </div>
            </div>
        </div>

        <!-- Education Section -->
        <div id="education" class="section">
            <h2>Education & Certifications</h2>
            <div class="grid">
                <div class="card">
                    <h3>BAC</h3>
                    <p>Currently enrolled as a technology-focused student. Expanding foundations in software architecture and systems engineering.</p>
                </div>
                <div class="card">
                    <h3>LinkedIn Certifications</h3>
                    <p>List relevant certificates here.</p>
                </div>
            </div>
        </div>

    </div>

    <!-- JavaScript Logic -->
    <script>
        function showSection(sectionId, buttonElement) {
            // Hide all sections
            document.querySelectorAll('.section').forEach(el => {
                el.classList.remove('active');
            });
            
            // Remove active state from all buttons
            document.querySelectorAll('.nav-links button').forEach(btn => {
                btn.classList.remove('active');
            });

            // Show selected section and highlight button
            document.getElementById(sectionId).classList.add('active');
            
            if (buttonElement) {
                buttonElement.classList.add('active');
            } else {
                // Handle fallback if triggered without clicking (e.g., initial load)
                document.querySelector('.nav-links button').classList.add('active');
            }
        }
    </script>
</body>
</html>
